{
  "name": "runbay",
  "version": "0.1.1",
  "description": "Not an installer. A launcher. Detect, launch, update and uninstall apps installed from the command line (npm, pnpm, yarn, bun, scoop) — in one modern window.",
  "main": "./out/main/index.js",
  "bin": {
    "runbay": "bin/runbay.js"
  },
  "files": [
    "bin",
    "out",
    "build"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icon": "node scripts/make-icon.mjs",
    "package:win": "npm run build && electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10skro/runbay.git"
  },
  "homepage": "https://github.com/10skro/runbay",
  "bugs": {
    "url": "https://github.com/10skro/runbay/issues"
  },
  "keywords": [
    "launcher",
    "cli",
    "package-manager",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "scoop",
    "electron",
    "windows",
    "desktop-app",
    "developer-tools",
    "self-update",
    "tray"
  ],
  "author": "Jerem (https://github.com/10skro)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron": "^44.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
